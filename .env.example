# Copy to .env and fill in. Never commit .env.

# "true" serves generated sample data and disables Gmail (used for the public demo).
DEMO_MODE=false

# Local SQLite file (git-ignored).
DATABASE_URL="file:./dev.db"

# Google Cloud OAuth client (type "Web application"). See README > Gmail setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Gmail search that selects the prospecting threads.
GMAIL_QUERY="in:sent label:prospeccion"

# Days without a reply before a follow-up is due.
FOLLOW_UP_DAYS=7

# UI language when no preference is saved: "es" or "en".
DEFAULT_LOCALE=es
